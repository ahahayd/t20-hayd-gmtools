{
  "id": "t20-hayd-gmtools",
  "title": "T20 Hayd GMTools",
  "description": "Ferramentas de Mestre para Tormenta20: oculta rolagens e criaturas dos jogadores, cria personagens, gera tesouros e gerencia o grupo.",
  "version": "2.9.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13",
    "maximum": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "tormenta20",
        "type": "system",
        "compatibility": {
          "minimum": "1.5.0"
        }
      }
    ],
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "compatibility": {}
      }
    ]
  },
  "socket": true,
  "esmodules": [
    "t20-hayd-gmtools.mjs",
    "t20-hayd-atributos.mjs",
    "t20-hayd-categorias-uso.mjs"
  ],
  "styles": [
    "t20-hayd-gmtools.css",
    "t20-hayd-management.css"
  ],
  "languages": [
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/pt-BR.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["t20-hayd-gmtools.css", "t20-hayd-management.css", "templates", "lang"]
    }
  },
  "url": "https://github.com/ahahayd/t20-hayd-gmtools",
  "manifest": "https://github.com/ahahayd/t20-hayd-gmtools/releases/latest/download/module.json",
  "download": "https://github.com/ahahayd/t20-hayd-gmtools/releases/download/v2.9.0/module.zip",
  "readme": "https://github.com/ahahayd/t20-hayd-gmtools/blob/main/README.md",
  "bugs": "https://github.com/ahahayd/t20-hayd-gmtools/issues",
  "license": "MIT",
  "authors": [
    {
      "name": "Hayd",
      "url": "https://github.com/ahahayd"
    }
  ]
}
