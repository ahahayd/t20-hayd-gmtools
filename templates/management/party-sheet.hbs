{{!--
  Ficha do Grupo.

  Três decisões de estrutura que valem a leitura:

  * O cartão de membro é um GRID de faixas (identidade, aptidões, traços,
    recursos), não uma pilha de divs. Com grid, nome e defesa de todos os
    membros caem na mesma linha de base, que é o que faz uma lista de
    personagens parecer uma tabela de verdade e não cartões soltos.
  * Deslocamento saiu do cartão: ocupava uma coluna inteira para repetir
    "9m" em todo mundo. No lugar entraram os traços que mudam de
    personagem para personagem e de rodada para rodada.
  * PV e PM ficam LADO A LADO. Eram três barras empilhadas ocupando a
    largura inteira da janela para mostrar dois números cada.
  * `thm-inv-item` continua sendo a classe das linhas de inventário: o
    arrastar/soltar do app procura por ela.
--}}
<div class="thm-sheet-root">
<nav class="tabs t20g-abas" data-group="primary">
  <a data-action="changeTab" data-group="primary" data-tab="members" class="{{#if (eq tab "members")}}active{{/if}}">
    <i class="fa-solid fa-users"></i> {{localize "THM.TabMembers"}}
  </a>
  <a data-action="changeTab" data-group="primary" data-tab="inventory" class="{{#if (eq tab "inventory")}}active{{/if}}">
    <i class="fa-solid fa-box-open"></i> {{localize "THM.TabInventory"}}
  </a>
  {{#if isGM}}
  <a data-action="changeTab" data-group="primary" data-tab="gm" class="{{#if (eq tab "gm")}}active{{/if}}">
    <i class="fa-solid fa-crown"></i> {{localize "THM.TabGm"}}
  </a>
  {{/if}}
</nav>

<section class="tab {{#if (eq tab "members")}}active{{/if}}" data-group="primary" data-tab="members">
  <div class="thm-members">
    {{#each members}}
    <article class="thm-member-card" data-actor-id="{{this.id}}">
      <img class="thm-portrait" src="{{this.img}}" alt="{{this.name}}" data-action="openActor" data-actor-id="{{this.id}}" />

      <header class="thm-member-head">
        <h3 class="thm-member-name" data-action="openActor" data-actor-id="{{this.id}}">{{this.name}}</h3>
        {{#if this.level}}<span class="thm-member-level">{{localize "THM.Level"}} {{this.level}}</span>{{/if}}
      </header>

      {{!-- Defesa fica na mesma linha do nome, encostada na direita: é o
            número que o Mestre procura primeiro, e fechar essa coluna acaba
            com o vazio que sobrava ao lado do nome. --}}
      <div class="thm-vital" data-tooltip="{{localize 'THM.Defense'}}">
        <span class="thm-vital-rotulo">{{localize "THM.Defense"}}</span>
        <span class="thm-vital-valor">{{this.defesa}}</span>
      </div>

      <div class="thm-stat-strip">
        <span class="t20g-chip" data-tooltip="{{localize 'THM.SaveFortitude'}}">
          <i class="fa-solid fa-heart-pulse"></i>{{this.fort}}
        </span>
        <span class="t20g-chip" data-tooltip="{{localize 'THM.SaveReflexes'}}">
          <i class="fa-solid fa-person-running"></i>{{this.refl}}
        </span>
        <span class="t20g-chip" data-tooltip="{{localize 'THM.SaveWill'}}">
          <i class="fa-solid fa-brain"></i>{{this.vont}}
        </span>
        <span class="thm-stat-sep"></span>
        <span class="t20g-chip" data-tooltip="{{localize 'THM.Perception'}}">
          <i class="fa-solid fa-eye"></i>{{this.percepcao}}
        </span>
        <span class="t20g-chip" data-tooltip="{{localize 'THM.Initiative'}}">
          <i class="fa-solid fa-bolt"></i>{{this.iniciativa}}
        </span>
      </div>

      {{!-- Traços: o que está pegando no personagem agora (condições e
            efeitos temporários) e o que ele é (sentidos). As condições vêm
            primeiro, em tom de aviso; os temporários, em tom de informação,
            com a duração no chip. A faixa some sozinha quando fica vazia. --}}
      <div class="thm-tracos">
        {{#each this.efeitos}}
        <span class="t20g-chip {{#if this.condicao}}thm-condicao{{else}}thm-efeito{{/if}}"
          data-tooltip="{{this.nome}}{{#if this.duracao}} — {{this.duracao}}{{/if}}">
          <img src="{{this.img}}" alt="" />{{this.nome}}{{#if this.duracao}} <small>{{this.duracao}}</small>{{/if}}
        </span>
        {{/each}}
        {{#each this.sentidos}}
        <span class="t20g-chip thm-sentido" data-tooltip="{{this.label}}">
          <i class="fa-solid {{this.icon}}"></i>{{this.label}}
        </span>
        {{/each}}
      </div>

      {{#unless ../hideBars}}
      <div class="thm-bars">
        <div class="t20g-medidor t20g-medidor--pv" data-tooltip="{{localize 'THM.TabMembers'}} — PV">
          <span class="t20g-medidor__rotulo">PV</span>
          <span class="t20g-medidor__valor">{{this.pv.label}}</span>
          <span class="t20g-medidor__trilho"><span class="t20g-medidor__preenche" style="width: {{this.pv.pct}}%"></span></span>
        </div>
        <div class="t20g-medidor t20g-medidor--pm">
          <span class="t20g-medidor__rotulo">PM</span>
          <span class="t20g-medidor__valor">{{this.pm.label}}</span>
          <span class="t20g-medidor__trilho"><span class="t20g-medidor__preenche" style="width: {{this.pm.pct}}%"></span></span>
        </div>
        {{#if this.carga}}
        <div class="t20g-medidor t20g-medidor--carga thm-carga {{#if this.carga.encumbered}}t20g-medidor--excedido{{/if}}" data-tooltip="{{this.carga.label}}">
          <span class="t20g-medidor__rotulo">{{localize "THM.EncumbranceShort"}}</span>
          <span class="t20g-medidor__valor">{{this.carga.curto}}</span>
          <span class="t20g-medidor__trilho"><span class="t20g-medidor__preenche" style="width: {{this.carga.pct}}%"></span></span>
        </div>
        {{/if}}
      </div>
      {{/unless}}
    </article>
    {{else}}
    <div class="t20g-vazio">
      <i class="fa-solid fa-users-slash"></i>
      <p class="t20g-vazio__titulo">{{localize "THM.NoMembersTitle"}}</p>
      <p class="t20g-vazio__texto">{{localize "THM.NoMembersHint"}}</p>
    </div>
    {{/each}}
  </div>
</section>

<section class="tab {{#if (eq tab "inventory")}}active{{/if}}" data-group="primary" data-tab="inventory">
  <div class="thm-money-row t20g-barra">
    {{#if showTl}}
    <span class="thm-coin" data-tooltip="{{localize 'THM.CoinTL'}}">
      <img src="modules/t20-hayd-gmtools/assets/moedas/moeda-tl.webp" alt="" />{{money.tl}} <small>TL</small>
    </span>
    {{/if}}
    <span class="thm-coin" data-tooltip="{{localize 'THM.CoinTO'}}">
      <img src="modules/t20-hayd-gmtools/assets/moedas/moeda-to.webp" alt="" />{{money.to}} <small>TO</small>
    </span>
    <span class="thm-coin" data-tooltip="{{localize 'THM.CoinTP'}}">
      <img src="modules/t20-hayd-gmtools/assets/moedas/moeda-tp.webp" alt="" />{{money.tp}} <small>TP</small>
    </span>
    <span class="thm-coin" data-tooltip="{{localize 'THM.CoinTC'}}">
      <img src="modules/t20-hayd-gmtools/assets/moedas/moeda-tc.webp" alt="" />{{money.tc}} <small>TC</small>
    </span>
    <div class="thm-money-actions t20g-espaco">
      <button type="button" class="t20g-btn" data-action="depositMoney" data-tooltip="{{localize 'THM.DepositMoneyTitle'}}">
        <i class="fa-solid fa-arrow-down"></i> {{localize "THM.DepositMoney"}}
      </button>
      {{!-- Mestre distribui para quem quiser; jogador só pega para si. --}}
      {{#if isGM}}
      <button type="button" class="t20g-btn" data-action="withdrawMoney" data-tooltip="{{localize 'THM.WithdrawMoneyTitle'}}">
        <i class="fa-solid fa-arrow-up"></i> {{localize "THM.WithdrawMoney"}}
      </button>
      {{else}}
      <button type="button" class="t20g-btn" data-action="withdrawMoney" data-tooltip="{{localize 'THM.TakeMoneyHint'}}">
        <i class="fa-solid fa-hand"></i> {{localize "THM.TakeMoney"}}
      </button>
      {{/if}}
      {{#if isGM}}
      <button type="button" class="t20g-btn t20g-btn--icone thm-edit-money" data-action="editStashMoney" data-tooltip="{{localize 'THM.EditStashMoneyTitle'}}">
        <i class="fa-solid fa-pen"></i>
      </button>
      {{/if}}
    </div>
  </div>

  <div class="thm-inv-list t20g-lista">
    {{#each items}}
    <div class="thm-inv-item t20g-linha" data-item-id="{{this.id}}" draggable="true">
      <img class="t20g-miniatura" src="{{this.img}}" alt="" />
      <span class="thm-item-name t20g-linha__nome">{{this.name}}</span>
      <span class="thm-item-qty">×{{this.qtd}}</span>
      <span class="thm-item-type t20g-chip">{{this.typeLabel}}</span>
      <div class="thm-item-acoes">
        {{#if ../isGM}}
        <button type="button" class="t20g-btn t20g-btn--icone t20g-btn--fantasma" data-action="sendStashItem" data-item-id="{{this.id}}" data-tooltip="{{localize 'THM.SendTo'}}">
          <i class="fa-solid fa-paper-plane"></i>
        </button>
        {{else}}
        {{!-- Jogador pega para o próprio personagem, sem escolher destinatário. --}}
        <button type="button" class="t20g-btn t20g-btn--icone t20g-btn--fantasma" data-action="takeStashItem" data-item-id="{{this.id}}" data-tooltip="{{localize 'THM.TakeItemHint'}}">
          <i class="fa-solid fa-hand"></i>
        </button>
        {{/if}}
        {{#if ../isGM}}
        <button type="button" class="t20g-btn t20g-btn--icone t20g-btn--fantasma" data-action="editStashItem" data-item-id="{{this.id}}" data-tooltip="{{localize 'THM.EditItem'}}">
          <i class="fa-solid fa-pen"></i>
        </button>
        {{/if}}
        {{!-- Apagar vale para qualquer membro do grupo; a gravação passa pelo
              Mestre, que revalida a permissão antes de mexer no estoque. --}}
        <button type="button" class="t20g-btn t20g-btn--icone t20g-btn--fantasma thm-danger" data-action="deleteStashItem" data-item-id="{{this.id}}" data-tooltip="{{localize 'THM.DeleteItem'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </div>
    {{else}}
    <div class="t20g-vazio">
      <i class="fa-solid fa-box-open"></i>
      <p class="t20g-vazio__titulo">{{localize "THM.NoItemsTitle"}}</p>
      <p class="t20g-vazio__texto">{{localize "THM.NoItemsHint"}}</p>
    </div>
    {{/each}}
  </div>
</section>

{{#if isGM}}
<section class="tab {{#if (eq tab "gm")}}active{{/if}}" data-group="primary" data-tab="gm">
  <div class="thm-gm-tools">
    <button type="button" class="thm-gm-acao" data-action="gmDistribute">
      <span class="thm-gm-icone"><i class="fa-solid fa-hand-holding-dollar"></i></span>
      <span class="thm-gm-titulo">{{localize "THM.DistributeMoneyTitle"}}</span>
      <small>{{localize "THM.DistributeMoneyDesc"}}</small>
    </button>
    <button type="button" class="thm-gm-acao" data-action="gmRest">
      <span class="thm-gm-icone"><i class="fa-solid fa-bed"></i></span>
      <span class="thm-gm-titulo">{{localize "THM.PartyRestTitle"}}</span>
      <small>{{localize "THM.PartyRestDesc"}}</small>
    </button>
    <button type="button" class="thm-gm-acao" data-action="gmSkillTest">
      <span class="thm-gm-icone"><i class="fa-solid fa-dice-d20"></i></span>
      <span class="thm-gm-titulo">{{localize "THM.SkillRequestTitle"}}</span>
      <small>{{localize "THM.SkillRequestDesc"}}</small>
    </button>
    <button type="button" class="thm-gm-acao" data-action="gmTreasure">
      <span class="thm-gm-icone"><i class="fa-solid fa-sack-dollar"></i></span>
      <span class="thm-gm-titulo">{{localize "THM.GenerateTreasureTitle"}}</span>
      <small>{{localize "THM.GenerateTreasureDesc"}}</small>
    </button>
  </div>
  <p class="thm-hint t20g-apoio">{{localize "THM.GmToolsHint"}}</p>
</section>
{{/if}}
</div>
